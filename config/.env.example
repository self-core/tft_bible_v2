# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Backend Configuration
MONGODB_URL=mongodb://mongodb:27017
DATABASE_NAME=tft_bible_dev
PORT=8080
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters
CORS_ORIGIN=http://localhost:3000

# Frontend Configuration
VITE_API_URL=http://localhost:8080

# RIOT API Configuration (if using external APIs)
RIOT_API_KEY=your_riot_api_key_here
RIOT_API_BASE_URL=https://americas.api.riotgames.com

# Trello Integration Configuration (for project management)
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_TOKEN=your_trello_token_here

# MongoDB Local Configuration (for docker-compose)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=tft_bible_dev

# Optional: Redis Configuration (if using caching)
# REDIS_URL=redis://redis:6379