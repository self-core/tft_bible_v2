{
  "name": "tft-bible-backend",
  "version": "1.0.0",
  "description": "Simplified backend for TFT Bible with GraphQL following scalable set-based architecture",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "tft",
    "tft-data",
    "tft-compositions",
    "teamfight-tactics",
