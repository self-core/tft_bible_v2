# TFT Bible Frontend Environment Variables

# GraphQL API Configuration
# In development, the Vite proxy will forward requests to the backend
VITE_GRAPHQL_URL=/graphql

# Backend API Base URL (used when deployed alongside backend)
VITE_API_BASE_URL=http://localhost:8080

# Additional configuration options
# VITE_GRAPHQL_URL=http://localhost:8080/graphql  # Direct connection to backend