{
  "version": 2,
  "name": "tft-bible-backend",
  "builds": [
    {
      "src": "backend-simple/package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/graphql",
      "dest": "backend-simple/dist/server.js"
    },
    {
      "src": "/health",
      "dest": "backend-simple/dist/server.js"
    }
  ],
  "env": {
    "MONGODB_URI": "$MONGODB_URI"
  }
}